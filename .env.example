APP_NAME="ARJ Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# WSL native: host 127.0.0.1 — jalur Docker (entrypoint.sh) menulis ulang ke host 'mysql'.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arj
DB_USERNAME=arj
DB_PASSWORD=secret

# Dev tanpa worker terpisah; jalur Docker memakai redis untuk ketiganya.
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=log

FILESYSTEM_DISK=local

# ARJ — versi aturan klasifikasi positif/negatif yang aktif.
ARJ_PHONE_RULE_VERSION=v1
